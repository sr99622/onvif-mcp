+#!/usr/bin/env python3
+"""Summarize anonymous (public) DCR clients in a Keycloak realm for orphan cleanup.
+Usage: script.py <clients_json_file> [active_client_id]
+Prints id/name/clientId/created per client, marking the active one."""
+import datetime
+import json
+import sys
+
+clients = json.load(open(sys.argv[1]))
+active = sys.argv[2] if len(sys.argv) > 2 else None
+
+for c in clients:
+    ts = c.get("created", 0) / 1000.0
+    when = datetime.datetime.utcfromtimestamp(ts).isoformat() + "Z"
+    mark = "ACTIVE" if active and c["clientId"] == active else "orphan?"
+    print(f'{mark:8} name={c.get("name")!r:32} clientId={c["clientId"]}  created={when}')
