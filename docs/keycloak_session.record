a//tmp/kc-token-check.py → b//tmp/kc-token-check.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Headless credential + token-claim verification for the Keycloak login user.
+Usage: script.py <secret_file> <realm> <username>
+Reads secret from a 0600 file, performs a resource-owner password grant,
+decodes the access-token payload (unverified) and prints only the claims.
+Never prints the credential or tokens."""
+import base64
+import json
+import sys
+import urllib.parse
+import urllib.request
+
+secret_file, realm, username = sys.argv[1], sys.argv[2], sys.argv[3]
+with open(secret_file) as f:
+    secret = f.read().strip()
+
+url = f"http://127.0.0.1:8080/auth/realms/{realm}/protocol/openid-connect/token"
+body = urllib.parse.urlencode({
+    "grant_type": "password",
+    "client_id": "credential-verify-test",
+    "client_secret": secret,
+    "username": username,
+    "password": secret,
+    "scope": "mcp:tools",
+}).encode()
+try:
+    with urllib.request.urlopen(
+        urllib.request.Request(url, data=body,
+                               headers={"Content-Type": "application/x-www-form-urlencoded"})
+    ) as resp:
+        d = json.loads(resp.read())
+except urllib.error.HTTPError as e:
+    detail = e.read()[:300].decode(errors="replace")
+    try:
+        j = json.loads(detail)
+        print("FAIL:", j.get("error"), "-", j.get("error_description"))
+    except Exception:
+        print("FAIL: HTTP", e.code, detail)
+    sys.exit(1)
+
+payload = d["access_token"].split(".")[1]
+claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
+print("password grant OK; tokens present:",
+      "access_token" in d and "refresh_token" in d)
+print("sub:", claims.get("sub"))
+print("iss:", claims.get("iss"))
+print("aud:", claims.get("aud"))
+print("scope:", claims.get("scope"))
