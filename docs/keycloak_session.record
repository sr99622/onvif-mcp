@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Headless credential verification for the Keycloak login user.
+Reads the client secret + user password from a 0600 temp file (both are the
+same value here), performs a resource-owner password grant, and prints only
+a success/failure line. Never prints the credential or tokens."""
+import json
+import sys
+import urllib.parse
+import urllib.request
+
+secret_file = sys.argv[1]
+realm = sys.argv[2]
+username = sys.argv[3]
+
+with open(secret_file) as f:
+    secret = f.read().strip()
+
+url = f"http://127.0.0.1:8080/auth/realms/{realm}/protocol/openid-connect/token"
+body = urllib.parse.urlencode({
+    "grant_type": "password",
+    "client_id": "credential-verify-test",
+    "client_secret": secret,
+    "username": username,
+    "password": secret,
+    "scope": "mcp:tools",
+}).encode()
+
+try:
+    with urllib.request.urlopen(
+        urllib.request.Request(url, data=body,
+                               headers={"Content-Type": "application/x-www-form-urlencoded"})
+    ) as resp:
+        d = json.loads(resp.read())
+    print("password grant OK: access+refresh tokens present =",
+          ("access_token" in d and "refresh_token" in d))
+except urllib.error.HTTPError as e:
+    detail = e.read()[:300].decode(errors="replace")
+    # Print only the error name/description, never any echoed credential
+    try:
+        d = json.loads(detail)
+        print("FAIL:", d.get("error"), "-", d.get("error_description"))
+    except Exception:
+        print("FAIL: HTTP", e.code)
  ┊ 💻 preparing terminal…
  ┊ 💻 $         chmod 600 "$tmpsecret" python3 /tmp/kc-cred-check.py "$tmpsecret" "$MCP_REALM" "$MCP_LOGIN_USER" rm -f "$tmpsecret" /tmp/kc-cred-check.py  0.3s

