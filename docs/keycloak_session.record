@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Assign a client scope to a client via Keycloak Admin REST API.
+Usage: script.py <admin_secret_file> <client_uuid> <scope_uuid>
+Prints only the resulting default-client-scopes list (ids + names)."""
+import base64
+import json
+import sys
+import urllib.parse
+import urllib.request
+
+secret_file, client_uuid, scope_uuid = sys.argv[1], sys.argv[2], sys.argv[3]
+with open(secret_file) as f:
+    secret = f.read().strip()
+
+base = "http://127.0.0.1:8080/auth"
+
+# 1. Admin token for master realm (password grant, same path kcadm uses)
+body = urllib.parse.urlencode({
+    "grant_type": "password",
+    "client_id": "admin-cli",
+    "username": "keycloak-admin",
+    "password": secret,
+}).encode()
+req = urllib.request.Request(
+    base + "/realms/master/protocol/openid-connect/token",
+    data=body, headers={"Content-Type": "application/x-www-form-urlencoded"})
+token = json.loads(urllib.request.urlopen(req).read())["access_token"]
+
+# 2. PUT the scope into the client's default-client-scopes
+url = (base + "/admin/realms/mcp/clients/" + client_uuid
+       + "/default-client-scopes/" + scope_uuid)
+req = urllib.request.Request(url, method="PUT", data=b"",
+                             headers={"Authorization": "Bearer " + token})
+urllib.request.urlopen(req).read()
+
+# 3. Read back the full default-scope list (ids + names only)
+req = urllib.request.Request(
+    base + "/admin/realms/mcp/clients/" + client_uuid
+    + "/default-client-scopes",
+    headers={"Authorization": "Bearer " + token})
+scopes = json.loads(urllib.request.urlopen(req).read())
+print("default scopes now:",
+      [s["name"] for s in scopes if not s["protocol"].startswith("saml")])
  ┊ 💻 preparing terminal…
  ┊ 💻 $         chmod 600 "$adminsecret" # script currently takes one secret file for the admin token + 1 command  7.2s

