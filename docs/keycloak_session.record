@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Headless completion of the Keycloak authorization-code flow for the Hermes MCP login test.
+
+Follows the browser path manually:
+  GET auth URL -> login form (relative action) -> POST credentials
+  -> consent screen (scope_consent, relative action) -> POST accept
+  -> 302 to http://127.0.0.1:<port>/callback?code=...&state=...
+The running `hermes mcp login` process listens on that callback port and captures
+the code+state itself; we merely complete the redirects like a browser would.
+
+Prints status lines only; never prints credentials, cookies, or tokens.
+"""
+import re
+import subprocess
+import sys
+import urllib.parse
+import urllib.request
+from http.cookiejar import CookieJar
+
+auth_url = sys.argv[1]
+username = "mcp-user"
+
+secret = subprocess.run(["sudo", "cat", "/opt/keycloak/mcp-user.pass"],
+                        capture_output=True, text=True).stdout.strip()
+
+cj = CookieJar()
+opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
+opener.addheaders = [("User-Agent", "login-flow-verification/1.0")]
+
+
+def get(url):
+    return opener.open(url)
+
+
+def post(base, action, fields):
+    """POST form fields to (possibly relative) action; returns the response after redirects."""
+    url = urllib.parse.urljoin(base, action) if not action.startswith("http") else action
+    body = urllib.parse.urlencode(fields).encode()
+    req = urllib.request.Request(url, data=body,
+                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
+    return opener.open(req)
+
+
+def form_fields(html):
+    """Hidden inputs -> {name: value}."""
+    return dict(re.findall(r'<input[^>]*\btype=["\']hidden["\'][^>]*>', html, re.S) and
+                [(m[1], m[2]) for m in re.findall(
+                    r'name=(["\'])([^"\']+)\1[^>]*value=(["\'])(.*?)\4', s, re.S)] or
+                [(m[1], m[3]) for m in re.findall(
