+#!/usr/bin/env bash
+# Isolated-home login attempt with live port-ownership watcher.
+rm -f /tmp/port-watch.log
+( while :; do ss -ltnp 2>/dev/null | grep ':27890' >> /tmp/port-watch.log 2>&1; sleep 0.3; done ) &
+watcher=$!
+cd /tmp
+env HERMES_HOME=/tmp/hh2 timeout 90 hermes mcp login camera-new > /tmp/login-isolated.log 2>&1
+rc=$?
+kill "$watcher" 2>/dev/null
+echo "login rc=$rc"
